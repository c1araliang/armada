@misc{klein2025Fleet,
  title = {Fleet of {{Agents}}: {{Coordinated Problem Solving}} with {{Large Language Models}}},
  shorttitle = {Fleet of {{Agents}}},
  author = {Klein, Lars and Potamitis, Nearchos and Aydin, Roland and West, Robert and Gulcehre, Caglar and Arora, Akhil},
  year = 2025,
