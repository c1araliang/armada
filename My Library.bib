@inproceedings{pawar2025Presumed,
  title = {Presumed {{Cultural Identity}}: {{How Names Shape LLM Responses}}},
  shorttitle = {Presumed {{Cultural Identity}}},
  booktitle = {Findings of the {{Association}} for {{Computational Linguistics}}: {{EMNLP}} 2025},
  author = {Pawar, Siddhesh Milind and Arora, Arnav and Kaffee, Lucie-Aim{\'e}e and Augenstein, Isabelle},
  editor = {Christodoulopoulos, Christos and Chakraborty, Tanmoy and Rose, Carolyn and Peng, Violet},
